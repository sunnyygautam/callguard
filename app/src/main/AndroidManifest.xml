<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Telephony & Call Screening Permissions:
        - READ_PHONE_STATE: Observe incoming call state / phone line readiness.
        - READ_CALL_LOG: Required on some devices/OS versions to receive incoming
          caller number details reliably alongside call screening.
        - ANSWER_PHONE_CALLS: Required for programmatic call rejection compatibility
          on older Android versions (pre-Android 10).
        Note: On Android 10+ (API 29+), holding RoleManager.ROLE_CALL_SCREENING is
        the official system mechanism for CallScreeningService interception.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Android Telecom CallScreeningService declaration.
            - android:permission="android.permission.BIND_SCREENING_SERVICE" ensures
              only the Android Telecom system service can bind to this service.
            - android:exported="true" is required for the system Telecom framework
              to discover and invoke onScreenCall().
        -->
        <service
            android:name=".telecom.PrefixCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
