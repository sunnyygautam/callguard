<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Telephony, Default Dialer, Call Screening & Overlay Permissions:
        - READ_PHONE_STATE: Observe phone/call line state.
        - READ_CALL_LOG: Read system call history & caller details reliably.
        - ANSWER_PHONE_CALLS: Programmatically accept/reject calls across Android versions.
        - CALL_PHONE: Place direct outgoing calls from CallGuard's dialer.
        - SYSTEM_ALERT_WINDOW: Overlay permission if floating caller ID is enabled.
        - USE_FULL_SCREEN_INTENT: Display InCallActivity over the lockscreen for incoming calls (Android 10+).
        - MODIFY_AUDIO_SETTINGS: Control mute and speakerphone audio routing during active calls.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!--
            MainActivity handles Launcher startup AND required DIAL / VIEW (tel:) intent-filters
            so Android Telecom recognizes CallGuard as an eligible Default Phone / Dialer app
            for RoleManager.ROLE_DIALER.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Required bare DIAL filter for ROLE_DIALER eligibility -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Required tel: URI filters for DIAL and VIEW links -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!--
            Dedicated full-screen In-Call UI Activity launched by CallGuardInCallService
            whenever Android Telecom routes an incoming or outgoing call to CallGuard.
        -->
        <activity
            android:name=".ui.incall.InCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:theme="@style/Theme.MyApplication"
            android:turnScreenOn="true" />

        <!--
            Android Telecom InCallService declaration (REQUIRED for ROLE_DIALER).
            - IN_CALL_SERVICE_UI=true tells Android Telecom that CallGuard provides its own
              incoming and outgoing call UI, handing over full call-screen control.
            - IN_CALL_SERVICE_RINGING=true allows handling ringing call presentation.
        -->
        <service
            android:name=".telecom.CallGuardInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!--
            Android Telecom CallScreeningService declaration (REQUIRED for ROLE_CALL_SCREENING).
        -->
        <service
            android:name=".telecom.PrefixCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!--
            BroadcastReceiver handling Answer, Decline, and End Call actions tapped
            directly from CallGuard's incoming/ongoing call notifications.
        -->
        <receiver
            android:name=".telecom.CallActionReceiver"
            android:exported="false" />

    </application>

</manifest>
